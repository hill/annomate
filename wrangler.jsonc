{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "annomate",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-01",
	// global_fetch_strictly_public: agents identify themselves by a metadata document URL, which
	// the OAuth server fetches. This keeps such a fetch off private addresses.
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*",
			"/auth/*",
			"/ws/*",
			"/mcp",
			"/authorize",
			"/oauth/*",
			"/.well-known/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "annomate",
			"database_id": "local",
			"migrations_dir": "worker/migrations"
		}
	],
	"kv_namespaces": [{ "binding": "OAUTH_KV", "id": "local" }],
	"durable_objects": {
		"bindings": [
			{ "name": "ROOM", "class_name": "ProjectRoom" },
			{ "name": "TEX", "class_name": "TexBox" }
		]
	},
	// LaTeX projects compile in TeX Live, one container per project.
	"containers": [
		{ "class_name": "TexBox", "image": "./container/Dockerfile", "instance_type": "standard-1", "max_instances": 20 }
	],
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["ProjectRoom"] },
		{ "tag": "v2", "new_sqlite_classes": ["TexBox"] }
	],
	"vars": {
		"GITHUB_CLIENT_ID": ""
	},
	// The top level is local development. Deploys build with CLOUDFLARE_ENV=production.
	// Bindings and vars do not inherit, so production repeats them with real IDs.
	"env": {
		"production": {
			"name": "annomate",
			"routes": [{ "pattern": "annomate.hill.xyz", "custom_domain": true }],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "annomate",
					"database_id": "1462cfd9-7446-40f0-b3fe-ae9e090ea2ff",
					"migrations_dir": "worker/migrations"
				}
			],
			"kv_namespaces": [{ "binding": "OAUTH_KV", "id": "d9e2141a00624a929fd6c1f4ed654d87" }],
			"durable_objects": {
				"bindings": [
					{ "name": "ROOM", "class_name": "ProjectRoom" },
					{ "name": "TEX", "class_name": "TexBox" }
				]
			},
			"containers": [
				{
					"class_name": "TexBox",
					"image": "./container/Dockerfile",
					"instance_type": "standard-1",
					"max_instances": 20
				}
			],
			"vars": {
				"GITHUB_CLIENT_ID": "Ov23liSqzC3EZcKjRedc"
			}
		}
	}
	// Secrets: GITHUB_CLIENT_SECRET, SESSION_SECRET, TOKEN_KEY (wrangler secret put, or .dev.vars locally)
}
